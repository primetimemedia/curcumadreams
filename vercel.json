{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "curcuma-dreams-interior.com"
        }
      ],
      "destination": "https://www.curcuma-dreams-interior.com/",
      "permanent": true
    },
    {
      "source": "/:path+",
      "has": [
        {
          "type": "host",
          "value": "curcuma-dreams-interior.com"
        }
      ],
      "destination": "https://www.curcuma-dreams-interior.com/:path+",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
