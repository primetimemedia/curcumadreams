{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "curcuma-dreams-interior.com"
        }
      ],
      "destination": "https://www.curcuma-dreams-interior.com/",
      "permanent": true
    },
    {
      "source": "/:path+",
      "has": [
        {
          "type": "host",
          "value": "curcuma-dreams-interior.com"
        }
      ],
      "destination": "https://www.curcuma-dreams-interior.com/:path+",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(favicon.ico|favicon-32.png|icon-192.png|icon-512.png|apple-touch-icon.png|og-image.jpg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
